---
// `/` is not a page: the server answers it with a 307 to `/dashboard`
// (see `dashboard_fallback` in src/server/dashboard/mod.rs), which is what
// 9router's `redirect('/dashboard')` does. This file only produces
// `web/dist/index.html` — the last-resort shell the embedded server falls back
// to for a path that is neither an asset nor a built page.
//
// It deliberately carries no redirect of its own. The meta-refresh stub this
// replaced looked harmless but fought `build.format: 'file'` and could send
// the browser back where it came from; a real 307 is a single response the
// router can reason about, and this page has nothing left to say.
import Layout from '@/layouts/Layout.astro';
---
<Layout title="OpenProxy">
  <main class="min-h-screen flex items-center justify-center bg-canvas px-4">
    <p class="text-sm text-muted">
      Continue to <a href="/dashboard" class="text-primary hover:underline">/dashboard</a>.
    </p>
  </main>
</Layout>
